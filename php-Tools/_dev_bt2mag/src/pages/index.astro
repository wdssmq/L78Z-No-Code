---
import BaseLayout from '../layouts/BaseLayout.astro'
import Main from '../components/Main.astro'
import SideBar from '../components/SideBar.astro'
---

<BaseLayout title="BT 种子转磁力链_BT 种子提取 ed2k">
    <div class="navbar bg-base-100">
        <div class="container mx-auto">
            <h1 class="btn btn-ghost text-xl">BT 种子转磁力链</h1>
        </div>
    </div>
    <div class="container mx-auto">
        <div class="grid grid-cols-12">
            <!-- 第一列 ↓ -->
            <div class="col-span-8 p-4">
                <Main />
            </div>
            <!-- 第二列 ↓ -->
            <div class="col-span-4 p-4">
                <SideBar />
            </div>
        </div>
    </div>

    <footer class="footer footer-center bg-base-300 text-base-content p-4">
        <aside>
            <p>
                <a
                    href="https://demo.wdssmq.com/tools/Pinyin/"
                    target="_blank"
                    title="心声体">心声体生成</a
                > |
                <a
                    href="https://demo.wdssmq.com/tools/"
                    target="_blank"
                    title="怪奇工具箱 - 各种奇怪的工具列表 - 水水的演示站"
                >怪奇工具箱</a
                > |
                <a href="http://www.wdssmq.com" target="_blank" title="沉冰浮水"
                >沉冰浮水</a
                >
            </p>
        </aside>
    </footer>
    <!-- <script
        src="https://cdn.jsdelivr.net/gh/wdssmq/userscript@main/dist-lib/lib-paiad.js"
    ></script> -->
    <script>
import * as mzLib from '../other/lib-paiad.js'
console.log(mzLib)
// 当调用 mzLib 时才会引入相应文件，但是 mzLib 又访问不到要用的对象

// 引入的对象会附加到 window 上
window.addEventListener('DOMContentLoaded', () => {
    // console.log(window);
    window.mzPaiad.config.interval = 2220
    window.mzPaiad.config.cntDownMax = 13
    window.mzPaiad.show()
    // console.log(window.mzPaiad.lsData)
})
    </script>
</BaseLayout>
